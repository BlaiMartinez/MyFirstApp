<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        tools:context=".MainActivity">

    <TextView
            android:id="@+id/textDisplay"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="?attr/colorOnSurface"
            app:autoSizeMaxTextSize="64sp"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0" />

    <Switch
            android:id="@+id/switchRadians"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_radians"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textDisplay" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSin"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@id/switchRadians"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintBottom_toTopOf="@id/btn7"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSin"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_sin"
            app:layout_constraintStart_toEndOf="@id/btnClear"
            app:layout_constraintEnd_toStartOf="@id/btnCos"
            app:layout_constraintTop_toBottomOf="@id/switchRadians"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintBottom_toTopOf="@id/btn8"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCos"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_cos"
            app:layout_constraintStart_toEndOf="@id/btnSin"
            app:layout_constraintEnd_toStartOf="@id/btnTan"
            app:layout_constraintTop_toBottomOf="@id/switchRadians"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintBottom_toTopOf="@id/btn9"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTan"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_tan"
            app:layout_constraintStart_toEndOf="@id/btnCos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switchRadians"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintBottom_toTopOf="@id/btnDivide"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn8"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@id/btnClear"
            app:layout_constraintBottom_toTopOf="@id/btn4"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_8"
            app:layout_constraintStart_toEndOf="@id/btn7"
            app:layout_constraintEnd_toStartOf="@id/btn9"
            app:layout_constraintTop_toBottomOf="@id/btnSin"
            app:layout_constraintBottom_toTopOf="@id/btn5"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_9"
            app:layout_constraintStart_toEndOf="@id/btn8"
            app:layout_constraintEnd_toStartOf="@id/btnDivide"
            app:layout_constraintTop_toBottomOf="@id/btnCos"
            app:layout_constraintBottom_toTopOf="@id/btn6"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDivide"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_divide"
            app:layout_constraintStart_toEndOf="@id/btn9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnTan"
            app:layout_constraintBottom_toTopOf="@id/btnMultiply"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@id/btn7"
            app:layout_constraintBottom_toTopOf="@id/btn1"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_5"
            app:layout_constraintStart_toEndOf="@id/btn4"
            app:layout_constraintEnd_toStartOf="@id/btn6"
            app:layout_constraintTop_toBottomOf="@id/btn8"
            app:layout_constraintBottom_toTopOf="@id/btn2"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_6"
            app:layout_constraintStart_toEndOf="@id/btn5"
            app:layout_constraintEnd_toStartOf="@id/btnMultiply"
            app:layout_constraintTop_toBottomOf="@id/btn9"
            app:layout_constraintBottom_toTopOf="@id/btn3"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMultiply"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_multiply"
            app:layout_constraintStart_toEndOf="@id/btn6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnDivide"
            app:layout_constraintBottom_toTopOf="@id/btnSubtract"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@id/btn4"
            app:layout_constraintBottom_toTopOf="@id/btn0"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_2"
            app:layout_constraintStart_toEndOf="@id/btn1"
            app:layout_constraintEnd_toStartOf="@id/btn3"
            app:layout_constraintTop_toBottomOf="@id/btn5"
            app:layout_constraintBottom_toTopOf="@id/btnDot"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_3"
            app:layout_constraintStart_toEndOf="@id/btn2"
            app:layout_constraintEnd_toStartOf="@id/btnSubtract"
            app:layout_constraintTop_toBottomOf="@id/btn6"
            app:layout_constraintBottom_toTopOf="@id/btnAdd"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubtract"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_subtract"
            app:layout_constraintStart_toEndOf="@id/btn3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMultiply"
            app:layout_constraintBottom_toTopOf="@id/btnEquals"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDot"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toBottomOf="@id/btn1"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_decimal"
            app:layout_constraintStart_toEndOf="@id/btn0"
            app:layout_constraintEnd_toStartOf="@id/btnAdd"
            app:layout_constraintTop_toBottomOf="@id/btn2"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_add"
            app:layout_constraintStart_toEndOf="@id/btnDot"
            app:layout_constraintEnd_toStartOf="@id/btnEquals"
            app:layout_constraintTop_toBottomOf="@id/btn3"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEquals"
            style="@style/Calculator.Key"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="@string/button_equals"
            app:layout_constraintStart_toEndOf="@id/btnAdd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSubtract"
            app:layout_constraintBottom_toBottomOf="parent"
            />

</androidx.constraintlayout.widget.ConstraintLayout>
